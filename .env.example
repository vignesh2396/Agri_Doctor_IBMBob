# Agri Doctor — Environment Variables Template
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it is listed in .gitignore.
#
# Encrypted values: when credentials are saved through the Developer Config
# page they are automatically encrypted (ENC:...) by dev_config.py.
# You can also store plain-text values here for local development.

# ── IBM watsonx Credentials ───────────────────────────────────────────────────
# Your IBM Cloud API key (Manage → Access (IAM) → API keys)
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# Your IBM watsonx.ai Project ID (Projects → Manage → General)
IBM_PROJECT_ID=your_project_id_here

# IBM watsonx endpoint URL for your region
IBM_ENDPOINT_URL=https://eu-de.ml.cloud.ibm.com

# ── Developer Config Page Security ───────────────────────────────────────────
#
# DEV_ADMIN_PASSWORD_HASH
#   bcrypt hash of the developer password (cost factor ≥ 12).
#   Default ships with hash of "changeme" — CHANGE THIS IN PRODUCTION.
#
#   Generate a new hash (Python):
#     import bcrypt
#     print(bcrypt.hashpw(b"your-new-password", bcrypt.gensalt(rounds=12)).decode())
#
# DEV_ENCRYPTION_KEY
#   Fernet symmetric encryption key used to encrypt credential values at rest.
#   Auto-generated and appended here on first use if absent.
#   Once set, do NOT change it unless you re-enter all credentials via the
#   config page (old encrypted values will become unreadable).
#
#   Generate manually (Python):
#     from cryptography.fernet import Fernet
#     print(Fernet.generate_key().decode())

# DEV_ADMIN_PASSWORD_HASH=$2b$12$cCH.J3g3mfMCp2.f9dGH7OybRVEnJ4.QkQ5nH8xVvGcB.kP1JoAEy
# DEV_ENCRYPTION_KEY=
